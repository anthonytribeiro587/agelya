# =================================================================
# Agelya — variáveis de ambiente
# Copie este arquivo para .env.local no desenvolvimento.
# Nunca versione chaves ou senhas reais.
# =================================================================

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Use o Session Pooler (Supavisor) em ambientes como a Vercel.
# Supabase → Connect → Session pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# ── Aplicação ─────────────────────────────────────────────────────
NEXT_PUBLIC_DEPLOYMENT_MODE=selfhosted
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# O login Google fica oculto enquanto não estiver configurado no Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ── Evolution API ─────────────────────────────────────────────────
# Normalmente a configuração é feita por negócio em
# Configurações → Notificações. Estes valores servem apenas como fallback.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ── Automações ────────────────────────────────────────────────────
# Protege /api/cron/notify. Gere um segredo longo e aleatório.
CRON_SECRET=troque-por-um-segredo-aleatorio

# Usado apenas por chamadas internas que ainda exijam autenticação servidor-servidor.
INTERNAL_API_SECRET=troque-por-um-segredo-aleatorio
